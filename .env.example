# Copy this file to .env and fill in your values. Never commit .env.

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used when the primary model is overloaded (503) or rate-limited (429). Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Seconds between Gemini calls; keeps the free tier within its per-minute limit.
GEMINI_MIN_INTERVAL_SECONDS=6

# --- Hunter.io (https://hunter.io/api-keys) ---
HUNTER_API_KEY=

# --- Gmail API (OAuth desktop client; download JSON from Google Cloud Console) ---
GMAIL_CREDENTIALS_FILE=credentials/gmail_client_secret.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json
SENDER_EMAIL=
SENDER_NAME=
# Seconds between emails when sending a batch (randomised ±20%).
SEND_INTERVAL_SECONDS=45

# --- App ---
DATABASE_PATH=data/outreach.db
# Hard cap is 15; a higher value is clamped down to 15.
DAILY_EMAIL_LIMIT=15
# Share of outreach targeted at Indian companies (0.0 - 1.0).
INDIA_RATIO=0.8
TIMEZONE=Asia/Kolkata
# Relevance score (0-100) an opportunity needs to be qualified.
QUALIFY_THRESHOLD=60
